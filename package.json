{
  "name": "io-game",
  "module": "apps/server/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:client": "vite build --config apps/client/vite.config.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:server": "if [ \"$DISABLE_TLS\" != \"1\" ] && [ -f certs/localhost.pem ] && [ -f certs/localhost-key.pem ]; then TLS_CERT_PATH=certs/localhost.pem TLS_KEY_PATH=certs/localhost-key.pem bun run apps/server/index.ts; else bun run apps/server/index.ts; fi",
    "generate:content-manifest": "bun run scripts/generate-content-manifest.ts",
    "build": "bun run typecheck && bun run build:client",
    "prod:server": "bun run apps/server/index.ts",
    "benchmark:optimization": "bun run scripts/optimization.test.ts",
    "benchmark:network-aoi": "bun run scripts/benchmarks/network-aoi.benchmark.ts",
    "benchmark:server-scenarios": "bun run scripts/benchmarks/server-scenarios.benchmark.ts",
    "benchmark:pathfinding": "bun run scripts/benchmarks/pathfinding.benchmark.ts",
    "benchmark:collision": "bun run scripts/benchmarks/collision.benchmark.ts",
    "benchmark:combat-burst": "bun run scripts/benchmarks/combat-burst.benchmark.ts",
    "benchmark:long-run": "bun run scripts/benchmarks/long-run.benchmark.ts",
    "benchmark:multiplayer-scale": "bun run scripts/benchmarks/multiplayer-scale.benchmark.ts",
    "benchmark:all": "bun run scripts/benchmarks/all.benchmark.ts",
    "benchmark:smoke": "BENCH_WARMUP_TICKS=5 BENCH_SAMPLE_TICKS=20 BENCH_COLLISION_ENEMIES=50 BENCH_COLLISION_WALLS=50 BENCH_COLLISION_PROJECTILES=20 bun run scripts/benchmarks/collision.benchmark.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test scripts/tests",
    "test:netcode": "bun test scripts/tests/netcode",
    "test:prediction": "bun test scripts/tests/prediction",
    "test:collision": "bun test scripts/tests/collision",
    "test:protocol": "bun test scripts/tests/protocol",
    "test:snapshot": "bun test scripts/tests/snapshot",
    "test:gameplay": "bun test scripts/tests/gameplay",
    "test:coverage": "bun test --coverage scripts/tests",
    "test:smoke": "bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.13",
    "@types/lodash-es": "^4.17.12",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "denque": "^2.1.0",
    "lodash-es": "^4.18.1",
    "pixi.js": "^8.18.1",
    "seedrandom": "^3.0.5",
    "zod": "^4.3.6"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
