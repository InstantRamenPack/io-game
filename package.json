{
  "name": "io-game",
  "module": "apps/server/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:client": "vite build --config apps/client/vite.config.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:server": "if [ \"$DISABLE_TLS\" != \"1\" ] && [ -f certs/localhost.pem ] && [ -f certs/localhost-key.pem ]; then TLS_CERT_PATH=certs/localhost.pem TLS_KEY_PATH=certs/localhost-key.pem bun run apps/server/index.ts; else bun run apps/server/index.ts; fi",
    "build": "bun run typecheck && bun run build:client",
    "prod:server": "bun run apps/server/index.ts",
    "test": "bun run test:unit",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun run scripts/playwright.ts",
    "test:e2e:headed": "bun run scripts/playwright.ts --headed",
    "test:e2e:debug": "bun run scripts/playwright.ts --debug",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "@types/bun": "latest",
    "@types/lodash-es": "^4.17.12",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "denque": "^2.1.0",
    "io-game": ".",
    "lodash-es": "^4.17.23",
    "pixi.js": "8.17.1",
    "seedrandom": "^3.0.5",
    "zod": "^4.3.6"
  }
}
